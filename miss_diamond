<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Miss Diamond — Try on the Evening Collection</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Manrope:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --navy: #1a2942; --navy-deep: #0d1828; --ink: #0a1422;
    --cream: #f5efe2; --cream-deep: #ebe3d2; --paper: #faf5ea;
    --champagne: #c9a96e; --champagne-dim: #a08a55; --burgundy: #6e1a2c; --ash: #7a736a;
    --hairline: rgba(26, 41, 66, 0.18);
    --font-display: 'Cormorant Garamond', Georgia, serif;
    --font-body: 'Manrope', -apple-system, sans-serif;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: var(--font-body); background: var(--paper); color: var(--ink); font-weight: 300; line-height: 1.55; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; overflow-x: hidden; }
  h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 400; letter-spacing: -0.01em; }
  .italic { font-style: italic; }
  .eyebrow { font-family: var(--font-body); font-size: 0.7rem; font-weight: 500; letter-spacing: 0.32em; text-transform: uppercase; color: var(--champagne-dim); }
  .caption { font-family: var(--font-display); font-style: italic; color: var(--ash); }
  .container { max-width: 1320px; margin: 0 auto; padding: 0 clamp(1.25rem, 4vw, 3rem); }

  .site-header { padding: 1.5rem 0; border-bottom: 1px solid var(--hairline); position: sticky; top: 0; background: rgba(250, 245, 234, 0.94); backdrop-filter: blur(10px); z-index: 50; }
  .header-row { display: flex; justify-content: space-between; align-items: center; }
  .brand-mark { font-family: var(--font-display); font-size: 1.5rem; font-weight: 500; letter-spacing: 0.05em; color: var(--ink); text-decoration: none; }
  .brand-mark .dot { color: var(--champagne); margin: 0 0.15em; font-style: italic; }
  .nav-meta { display: flex; gap: 1.75rem; align-items: center; font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ash); }
  .nav-meta a { color: inherit; text-decoration: none; transition: color 0.2s; }
  .nav-meta a:hover { color: var(--ink); }
  .lang-toggle { border: 1px solid var(--hairline); padding: 0.35rem 0.75rem; border-radius: 999px; font-size: 0.68rem; }

  .intro { padding: clamp(3rem, 6vw, 5rem) 0 clamp(3rem, 5vw, 4rem); }
  .intro-grid { display: grid; grid-template-columns: 1fr 0.85fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .intro-eyebrow { margin-bottom: 1.5rem; }
  .intro-headline { font-size: clamp(2.4rem, 5vw, 4.5rem); line-height: 0.98; font-weight: 300; color: var(--ink); margin-bottom: 1.5rem; max-width: 16ch; }
  .intro-headline .accent { font-style: italic; color: var(--navy); }
  .intro-sub { font-size: 1rem; color: var(--ash); max-width: 38ch; line-height: 1.7; }
  .intro-sub strong { color: var(--ink); font-weight: 500; }

  .intro-upload { display: flex; flex-direction: column; gap: 0.75rem; }
  .upload-label { font-size: 0.7rem; letter-spacing: 0.28em; text-transform: uppercase; color: var(--champagne-dim); font-weight: 500; margin-bottom: 0.25rem; }
  .upload-zone { min-height: 200px; border: 1px dashed var(--ash); background: var(--cream); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.85rem; padding: 1.75rem; cursor: pointer; transition: all 0.3s ease; position: relative; overflow: hidden; background-size: cover; background-position: center; }
  .upload-zone:hover { border-color: var(--navy); background-color: var(--cream-deep); }
  .upload-zone.has-file { border-style: solid; border-color: var(--navy); padding: 0; min-height: 240px; }
  .upload-zone.pulse { animation: pulse-attention 1.2s ease-in-out 2; }
  @keyframes pulse-attention { 0%, 100% { transform: scale(1); border-color: var(--ash); } 50% { transform: scale(1.015); border-color: var(--burgundy); } }
  .upload-icon { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--ash); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: 1.6rem; color: var(--ash); transition: all 0.25s; }
  .upload-zone:hover .upload-icon { border-color: var(--navy); color: var(--navy); }
  .upload-text { font-family: var(--font-display); font-style: italic; font-size: 1.1rem; color: var(--ink); text-align: center; }
  .upload-hint { font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ash); text-align: center; }
  .upload-disclaimer { font-family: var(--font-display); font-style: italic; font-size: 0.85rem; color: var(--ash); line-height: 1.5; }

  .tryon { padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(4rem, 7vw, 6rem); }
  .tryon-header { padding: 1.5rem 0 2.5rem; border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); margin-bottom: clamp(2.5rem, 4vw, 3.5rem); }
  .tryon-header-row { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 1.5rem; }
  .tryon-header h2 { font-size: clamp(1.4rem, 2vw, 1.7rem); font-weight: 400; line-height: 1.2; }
  .tryon-header h2 .italic { color: var(--navy); }
  .tryon-header .caption { font-size: 0.95rem; }

  .stage > div { display: none; animation: fadeIn 0.55s ease forwards; }
  .stage > div.active { display: block; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  .dress-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: clamp(0.85rem, 1.6vw, 1.3rem); }
  .dress-card { cursor: pointer; background: transparent; border: none; padding: 0; text-align: left; transition: transform 0.4s ease; font-family: inherit; }
  .dress-card:hover { transform: translateY(-4px); }
  .dress-image { aspect-ratio: 3 / 4; position: relative; overflow: hidden; margin-bottom: 0.85rem; background-size: cover; background-position: center; background-repeat: no-repeat; background-color: var(--cream); }
  .dress-image.champagne  { background-image: linear-gradient(160deg, #c9a96e 0%, #8a6f3d 100%); }
  .dress-image.onyx       { background-image: linear-gradient(160deg, #1c1c1c 0%, #060606 100%); }
  .dress-image.emerald    { background-image: linear-gradient(160deg, #1e4a3a 0%, #0e2820 100%); }
  .dress-image.has-image { background-size: contain; background-image: none; }
  .dress-image::after { content: ""; position: absolute; inset: 0; background: radial-gradient(ellipse at 30% 30%, rgba(255,255,255,0.06), transparent 60%), radial-gradient(ellipse at 70% 80%, rgba(0,0,0,0.18), transparent 65%); pointer-events: none; }
  .dress-image.has-image::after { background: none; }

  .dress-card[data-dress="amour"]    .dress-image.has-image { background-image: var(--img-amour); }
  .dress-card[data-dress="becky"]    .dress-image.has-image { background-image: var(--img-becky); }
  .dress-card[data-dress="maltissa"] .dress-image.has-image { background-image: var(--img-maltissa); }
  .dress-card[data-dress="cannes"]   .dress-image.has-image { background-image: var(--img-cannes); }
  .dress-card[data-dress="lacresia"] .dress-image.has-image { background-image: var(--img-lacresia); }

  .dress-meta { display: flex; justify-content: flex-end; align-items: baseline; }
  .dress-meta .price { font-size: 0.72rem; color: var(--ash); letter-spacing: 0.16em; white-space: nowrap; }

  .btn-primary { display: inline-flex; align-items: center; gap: 1rem; background: var(--navy); color: var(--cream); padding: 1.1rem 2.1rem; border: none; font-family: var(--font-body); font-size: 0.74rem; font-weight: 500; letter-spacing: 0.28em; text-transform: uppercase; cursor: pointer; transition: all 0.3s ease; text-decoration: none; }
  .btn-primary:hover { background: var(--ink); transform: translateY(-1px); }
  .btn-outline { display: inline-flex; align-items: center; justify-content: space-between; gap: 1rem; background: transparent; border: 1px solid var(--ink); color: var(--ink); padding: 1rem 1.5rem; font-family: var(--font-body); font-size: 0.74rem; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; cursor: pointer; transition: all 0.25s ease; text-decoration: none; }
  .btn-outline:hover { background: var(--ink); color: var(--cream); }
  .btn-outline .arrow { font-family: var(--font-display); font-style: italic; font-size: 1.05rem; letter-spacing: 0; }
  .btn-outline.subtle { border-color: var(--hairline); color: var(--ash); }
  .btn-outline.subtle:hover { border-color: var(--navy); color: var(--navy); background: transparent; }

  .loading-stage { text-align: center; padding: clamp(2rem, 6vw, 5rem) 0; }
  .loading-mark { width: 60px; height: 60px; border-radius: 50%; border: 1px solid var(--champagne); margin: 0 auto 2.5rem; position: relative; animation: pulse-mark 2.4s ease-in-out infinite; }
  .loading-mark::after { content: ""; position: absolute; inset: 11px; border-radius: 50%; background: var(--champagne); opacity: 0.4; animation: pulse-inner 2.4s ease-in-out infinite; }
  @keyframes pulse-mark { 0%, 100% { transform: scale(1); border-color: var(--champagne); } 50% { transform: scale(1.1); border-color: var(--champagne-dim); } }
  @keyframes pulse-inner { 0%, 100% { opacity: 0.4; transform: scale(1); } 50% { opacity: 0.75; transform: scale(0.7); } }
  .loading-headline { font-family: var(--font-display); font-size: clamp(1.7rem, 3vw, 2.5rem); font-style: italic; color: var(--ink); margin-bottom: 1.25rem; line-height: 1.2; max-width: 30ch; margin-left: auto; margin-right: auto; }
  .loading-sub { font-size: 0.95rem; color: var(--ash); max-width: 38ch; margin: 0 auto 2.5rem; line-height: 1.7; }
  .loading-bar { width: 220px; height: 1px; background: var(--hairline); margin: 0 auto; position: relative; overflow: hidden; }
  .loading-bar::after { content: ""; position: absolute; height: 100%; width: 40%; background: var(--navy); animation: slide 1.6s ease-in-out infinite; }
  @keyframes slide { 0% { left: -40%; } 100% { left: 100%; } }
  .loading-quote { font-family: var(--font-display); font-style: italic; color: var(--ash); font-size: 0.98rem; margin-top: 2.5rem; max-width: 42ch; margin-left: auto; margin-right: auto; line-height: 1.6; }
  .loading-quote .attribution { display: block; font-size: 0.7rem; letter-spacing: 0.22em; text-transform: uppercase; font-style: normal; color: var(--champagne-dim); margin-top: 0.8rem; }

  .result-stage { display: grid; grid-template-columns: 0.58fr 0.42fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .result-image-frame { aspect-ratio: 3 / 4; position: relative; overflow: hidden; background-color: var(--cream); background-image: linear-gradient(165deg, #1f2f4a 0%, #0d1828 100%); }
  .result-image-frame.has-image { background-image: none; }
  .result-image-layer { position: absolute; inset: 0; background-size: contain; background-position: center; background-repeat: no-repeat; transition: opacity 0.4s ease; }
  .result-image-layer.before { opacity: 0; }
  .result-image-layer.after { opacity: 1; }
  .result-image-frame.show-before .before { opacity: 1; }
  .result-image-frame.show-before .after { opacity: 0; }
  .result-image-frame::before { content: ""; position: absolute; inset: 0; background: radial-gradient(ellipse at 30% 25%, rgba(201, 169, 110, 0.18), transparent 60%), radial-gradient(ellipse at 75% 80%, rgba(110, 26, 44, 0.2), transparent 55%); pointer-events: none; z-index: 1; }
  .result-image-frame.has-image::before { background: none; }
  .placeholder-mark { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.85rem; color: rgba(245, 239, 226, 0.5); z-index: 2; pointer-events: none; }
  .placeholder-mark .label { font-family: var(--font-display); font-style: italic; font-size: 1.05rem; letter-spacing: 0.05em; }
  .placeholder-mark .hint { font-size: 0.66rem; letter-spacing: 0.25em; text-transform: uppercase; color: rgba(245, 239, 226, 0.4); }
  .result-image-frame.has-image .placeholder-mark { display: none; }
  .toggle-row { position: absolute; top: 1rem; right: 1rem; display: flex; gap: 0; background: rgba(13, 24, 40, 0.8); backdrop-filter: blur(8px); padding: 0.25rem; z-index: 4; }
  .toggle-btn { background: transparent; border: none; color: rgba(245, 239, 226, 0.6); font-family: var(--font-body); font-size: 0.66rem; letter-spacing: 0.22em; text-transform: uppercase; padding: 0.5rem 1rem; cursor: pointer; transition: all 0.2s; }
  .toggle-btn.active { color: var(--cream); background: rgba(245, 239, 226, 0.12); }
  .result-right .eyebrow { margin-bottom: 1.25rem; }
  .result-right h3 { font-size: clamp(1.9rem, 3vw, 2.6rem); line-height: 1.1; margin-bottom: 0.5rem; font-style: italic; }
  .result-right .product-price { font-size: 1.05rem; color: var(--ink); margin-bottom: 0.4rem; margin-top: 1.5rem; }
  .result-right .product-meta { font-size: 0.68rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ash); margin-bottom: 2.25rem; }
  .result-actions { display: flex; flex-direction: column; gap: 0.85rem; margin-bottom: 2.25rem; }
  .result-disclaimer { font-family: var(--font-display); font-style: italic; font-size: 0.92rem; color: var(--ash); border-top: 1px solid var(--hairline); padding-top: 1.25rem; line-height: 1.6; }

  .how { padding: clamp(4rem, 7vw, 6rem) 0; background: var(--cream); border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
  .how-header { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 1.5rem; margin-bottom: 3rem; }
  .how-header h2 { font-size: clamp(1.6rem, 2.5vw, 2.2rem); line-height: 1.2; max-width: 22ch; }
  .how-header h2 .italic { color: var(--navy); }
  .how-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 3vw, 3rem); }
  .step { position: relative; padding-top: 1.5rem; border-top: 1px solid var(--ink); }
  .step-num { position: absolute; top: -0.8rem; left: 0; background: var(--cream); padding-right: 0.75rem; font-family: var(--font-display); font-style: italic; font-size: 1rem; color: var(--champagne-dim); }
  .step h3 { font-size: 1.4rem; line-height: 1.2; margin-bottom: 0.75rem; }
  .step p { font-size: 0.92rem; color: var(--ash); max-width: 30ch; line-height: 1.6; }

  .trust { padding: clamp(3.5rem, 6vw, 5rem) 0; background: var(--navy); color: var(--cream); }
  .trust-grid { display: grid; grid-template-columns: 0.38fr 0.62fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .trust .eyebrow { color: var(--champagne); }
  .trust h3 { font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--cream); line-height: 1.2; margin-top: 0.75rem; }
  .trust p { color: rgba(245, 239, 226, 0.75); font-size: 0.98rem; line-height: 1.75; max-width: 56ch; }
  .trust p + p { margin-top: 1.2rem; }

  .site-footer { padding: 2.5rem 0 2rem; background: var(--navy-deep); color: rgba(245, 239, 226, 0.55); border-top: 1px solid rgba(245, 239, 226, 0.06); }
  .footer-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.25rem; font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; }
  .footer-row .brand-mark { color: var(--cream); }
  .footer-links { display: flex; gap: 2rem; }
  .footer-links a { color: inherit; text-decoration: none; transition: color 0.2s; }
  .footer-links a:hover { color: var(--cream); }

  .reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.8s ease, transform 0.8s ease; }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  .reveal-delay-1 { transition-delay: 0.08s; }
  .reveal-delay-2 { transition-delay: 0.16s; }

  @media (max-width: 1100px) { .dress-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 900px) {
    .intro-grid, .result-stage, .trust-grid { grid-template-columns: 1fr; gap: 2rem; }
    .tryon-header-row { flex-direction: column; align-items: flex-start; }
    .dress-grid { grid-template-columns: repeat(2, 1fr); }
    .how-steps { grid-template-columns: 1fr; gap: 2rem; }
    .nav-meta .meta-link { display: none; }
  }
  @media (max-width: 560px) { .dress-grid { grid-template-columns: 1fr; } .intro { padding: 2rem 0; } }
</style>
</head>
<body>

<header class="site-header">
  <div class="container">
    <div class="header-row">
      <a href="#" class="brand-mark">Miss<span class="dot">&middot;</span>Diamond</a>
      <nav class="nav-meta">
        <a href="https://missdiamond.ua/en" class="meta-link" target="_blank">Shop the collection</a>
        <span class="lang-toggle">EN&nbsp;&nbsp;/&nbsp;&nbsp;UA</span>
      </nav>
    </div>
  </div>
</header>

<section class="intro" id="intro">
  <div class="container">
    <div class="intro-grid">
      <div>
        <div class="eyebrow intro-eyebrow reveal">Virtual fitting &middot; Atelier Miss Diamond</div>
        <h1 class="intro-headline reveal reveal-delay-1">
          See yourself in the <span class="accent">Evening</span> Collection.
        </h1>
        <p class="intro-sub reveal reveal-delay-2">
          <strong>Begin with one photograph of yourself.</strong> Then choose a piece below, and receive a portrait of yourself in the gown &mdash; composed on a red carpet, in studio light.
        </p>
      </div>
      <div class="intro-upload reveal reveal-delay-2">
        <div class="upload-label">Step one &middot; your photograph</div>
        <div class="upload-zone" id="upload-zone">
          <div class="upload-icon">+</div>
          <div class="upload-text">Drop your photograph here</div>
          <div class="upload-hint">or click to choose &middot; jpg, png, up to 10 mb</div>
          <input type="file" id="file-input" accept="image/*" style="display:none;">
        </div>
        <p class="upload-disclaimer">Used for this fitting only. Dissolved within twenty-four hours. Never seen by a human except, briefly, you.</p>
      </div>
    </div>
  </div>
</section>

<section class="tryon" id="try-it">
  <div class="container">
    <div class="tryon-header">
      <div class="tryon-header-row">
        <h2 id="tryon-title">Step two &middot; the <span class="italic">Atelier</span></h2>
        <p class="caption" id="tryon-subtitle">Five pieces. Click any garment to begin.</p>
      </div>
    </div>

    <div class="stage" id="stage">

      <div id="stage-gallery" class="active">
        <div class="dress-grid">
          <button class="dress-card reveal " data-dress="amour" data-tone="champagne" data-price="UAH 13,900" data-meta="Glitter bustier &middot; Mini" data-url="https://missdiamond.ua/en/vecirni-sukni/amour">
            <div class="dress-image champagne"></div>
            <div class="dress-meta"><span class="price">UAH 13,900</span></div>
          </button>
          <button class="dress-card reveal " data-dress="becky" data-tone="champagne" data-price="UAH 15,900" data-meta="Crystal-embellished &middot; Floor-length" data-url="https://missdiamond.ua/en/vecirni-sukni/becky">
            <div class="dress-image champagne"></div>
            <div class="dress-meta"><span class="price">UAH 15,900</span></div>
          </button>
          <button class="dress-card reveal " data-dress="maltissa" data-tone="onyx" data-price="UAH 7,900" data-meta="Crepe &middot; Mermaid &middot; Floor-length" data-url="https://missdiamond.ua/en/vecirni-sukni/maltissa">
            <div class="dress-image onyx"></div>
            <div class="dress-meta"><span class="price">UAH 7,900</span></div>
          </button>
          <button class="dress-card reveal reveal-delay-1" data-dress="cannes" data-tone="emerald" data-price="UAH 79,900" data-meta="Jersey &middot; Lace-up &middot; Floor-length" data-url="https://missdiamond.ua/en/vecirni-sukni/cannes-dress">
            <div class="dress-image emerald"></div>
            <div class="dress-meta"><span class="price">UAH 79,900</span></div>
          </button>
          <button class="dress-card reveal reveal-delay-1" data-dress="lacresia" data-tone="emerald" data-price="UAH 7,900" data-meta="3D floral appliqué &middot; Mini" data-url="https://missdiamond.ua/en/vecirni-sukni/lacresia">
            <div class="dress-image emerald"></div>
            <div class="dress-meta"><span class="price">UAH 7,900</span></div>
          </button>
        </div>
      </div>

      <div id="stage-loading">
        <div class="loading-stage">
          <div class="loading-mark"></div>
          <h3 class="loading-headline">A portrait is being composed.</h3>
          <p class="loading-sub">Studio light, fabric, posture &mdash; held together for a moment. Allow about ten seconds for the image to settle.</p>
          <div class="loading-bar"></div>
          <p class="loading-quote">
            &ldquo;The dress should feel like a memory you haven&rsquo;t made yet.&rdquo;
            <span class="attribution">&mdash; Alina Malenka, founder</span>
          </p>
        </div>
      </div>

      <div id="stage-result">
        <div class="result-stage">
          <div class="result-image-frame" id="result-image-frame">
            <div class="result-image-layer before" id="result-before"></div>
            <div class="result-image-layer after" id="result-after"></div>
            <div class="placeholder-mark" id="placeholder-mark">
              <span class="label">Your portrait</span>
              <span class="hint">generated image will appear here</span>
            </div>
            <div class="toggle-row">
              <button class="toggle-btn active" data-view="after">After</button>
              <button class="toggle-btn" data-view="before">Before</button>
            </div>
          </div>
          <div class="result-right">
            <div class="eyebrow">Your fitting</div>
            <h3>Composed for you.</h3>
            <p class="product-price" id="result-price">UAH 15,900</p>
            <p class="product-meta" id="result-meta">Crystal-embellished &middot; Floor-length</p>
            <div class="result-actions">
              <a class="btn-outline" id="result-shop-link" href="https://missdiamond.ua/en" target="_blank">
