<script>
(function() {
  'use strict';

  const DRESS_IMAGES = {
    amour: 'data:image/jpeg;base64,',
    becky: 'data:image/jpeg;base64,',
    maltissa: 'data:image/jpeg;base64,',
    cannes: 'data:image/jpeg;base64,',
    lacresia: 'data:image/jpeg;base64,',
  };

  // Generated "after" images — paste base64 or URLs here once you have them from Nano Banana
  const DRESS_RESULTS = {
    amour: '',
    becky: '',
    maltissa: '',
    cannes: '',
    lacresia: '',
  };

  const DRESS_URLS = {
    amour: 'https://missdiamond.ua/en/vecirni-sukni/amour',
    becky: 'https://missdiamond.ua/en/vecirni-sukni/becky',
    maltissa: 'https://missdiamond.ua/en/vecirni-sukni/maltissa',
    cannes: 'https://missdiamond.ua/en/vecirni-sukni/cannes-dress',
    lacresia: 'https://missdiamond.ua/en/vecirni-sukni/lacresia',
  };

  // GENERATION REFERENCES — for live backend (Vercel + Gemini API) integration
  // These are the outfit reference images used as Image B in the prompt
  // const DRESS_GENERATION_REFS = {
  //   amour:    './images/amour.jpg',
  //   becky:    './images/becky.jpg',
  //   maltissa: './images/maltissa.jpg',
  //   cannes:   './images/cannes.jpg',
  //   lacresia: './images/lacresia.jpg',
  // };

  const root = document.documentElement;
  for (const [name, url] of Object.entries(DRESS_IMAGES)) {
    if (url) root.style.setProperty(`--img-${name}`, `url("${url}")`);
  }
  document.querySelectorAll('.dress-card').forEach(card => {
    const id = card.dataset.dress;
    if (DRESS_IMAGES[id]) card.querySelector('.dress-image').classList.add('has-image');
  });

  const state = { selectedDress: null, selectedTone: null, selectedPrice: null, selectedMeta: null, userPhotoDataUrl: null };
  const stages = { gallery: document.getElementById('stage-gallery'), loading: document.getElementById('stage-loading'), result: document.getElementById('stage-result') };

  function showStage(name) {
    Object.values(stages).forEach(s => s.classList.remove('active'));
    stages[name].classList.add('active');
    updateHeader(name);
    if (name !== 'gallery') {
      const section = document.getElementById('try-it');
      if (section) {
        const y = section.getBoundingClientRect().top + window.scrollY - 80;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }
    }
  }

  function updateHeader(stage) {
    const title = document.getElementById('tryon-title');
    const sub = document.getElementById('tryon-subtitle');
    if (stage === 'gallery') { title.innerHTML = 'Step two &middot; the <span class="italic">Atelier</span>'; sub.textContent = 'Five pieces. Click any garment to begin.'; }
    else if (stage === 'loading') { title.innerHTML = 'One <span class="italic">moment</span>.'; sub.textContent = 'The portrait is being composed.'; }
    else if (stage === 'result') { title.innerHTML = 'Your <span class="italic">fitting</span>.'; sub.textContent = 'Shop the look, or try another piece.'; }
  }

  const uploadZone = document.getElementById('upload-zone');
  function bindFileInput() {
    const fileInput = document.getElementById('file-input');
    if (fileInput) fileInput.addEventListener('change', (e) => { const file = e.target.files[0]; if (file) handleFile(file); });
  }
  bindFileInput();
  uploadZone.addEventListener('click', (e) => {
    if (e.target.tagName !== 'INPUT') { const input = document.getElementById('file-input'); if (input) input.click(); }
  });
  ['dragenter', 'dragover'].forEach(evt => { uploadZone.addEventListener(evt, (e) => { e.preventDefault(); uploadZone.classList.add('has-file'); }); });
  uploadZone.addEventListener('dragleave', (e) => { e.preventDefault(); if (!state.userPhotoDataUrl) uploadZone.classList.remove('has-file'); });
  uploadZone.addEventListener('drop', (e) => { e.preventDefault(); const file = e.dataTransfer.files[0]; if (file) handleFile(file); });

  function handleFile(file) {
    const reader = new FileReader();
    reader.onload = (e) => {
      state.userPhotoDataUrl = e.target.result;
      uploadZone.classList.add('has-file');
      uploadZone.style.backgroundImage = `url('${e.target.result}')`;
      uploadZone.innerHTML = `
        <div style="position:absolute; inset:0; background:linear-gradient(180deg, rgba(13,24,40,0) 40%, rgba(13,24,40,0.88) 100%); display:flex; align-items:flex-end; padding:1.25rem;">
          <div style="color:var(--cream); display:flex; justify-content:space-between; width:100%; align-items:flex-end;">
            <div style="font-family:var(--font-display); font-style:italic; font-size:1.05rem;">Photograph received</div>
            <button style="background:transparent; border:1px solid rgba(245,239,226,0.4); color:var(--cream); padding:0.4rem 0.8rem; font-size:0.65rem; letter-spacing:0.22em; text-transform:uppercase; cursor:pointer; font-family:var(--font-body);" onclick="event.stopPropagation(); window.__resetPhoto();">Replace</button>
          </div>
        </div>
      `;
    };
    reader.readAsDataURL(file);
  }
  window.__resetPhoto = function() {
    state.userPhotoDataUrl = null;
    uploadZone.classList.remove('has-file');
    uploadZone.style.backgroundImage = '';
    uploadZone.innerHTML = `
      <div class="upload-icon">+</div>
      <div class="upload-text">Drop your photograph here</div>
      <div class="upload-hint">or click to choose &middot; jpg, png, up to 10 mb</div>
      <input type="file" id="file-input" accept="image/*" style="display:none;">
    `;
    bindFileInput();
  };

  document.querySelectorAll('.dress-card').forEach(card => {
    card.addEventListener('click', () => {
      if (!state.userPhotoDataUrl) {
        const intro = document.getElementById('intro');
        if (intro) {
          const y = intro.getBoundingClientRect().top + window.scrollY - 80;
          window.scrollTo({ top: y, behavior: 'smooth' });
        }
        uploadZone.classList.add('pulse');
        setTimeout(() => uploadZone.classList.remove('pulse'), 2600);
        return;
      }
      state.selectedDress = card.dataset.dress;
      state.selectedTone = card.dataset.tone;
      state.selectedPrice = card.dataset.price;
      state.selectedMeta = card.dataset.meta;
      showStage('loading');
      setTimeout(() => { composeResult(); showStage('result'); }, 4200);
    });
  });

  function composeResult() {
    const frame = document.getElementById('result-image-frame');
    const beforeLayer = document.getElementById('result-before');
    const afterLayer = document.getElementById('result-after');
    beforeLayer.style.backgroundImage = `url('${state.userPhotoDataUrl}')`;
    const resultUrl = DRESS_RESULTS[state.selectedDress];
    if (resultUrl) {
      afterLayer.style.backgroundImage = `url('${resultUrl}')`;
      frame.classList.add('has-image');
    } else {
      afterLayer.style.backgroundImage = '';
      frame.classList.remove('has-image');
    }
    frame.classList.remove('show-before');
    document.querySelectorAll('.toggle-btn').forEach(b => b.classList.remove('active'));
    document.querySelector('.toggle-btn[data-view="after"]').classList.add('active');
    document.getElementById('result-price').textContent = state.selectedPrice;
    document.getElementById('result-meta').innerHTML = state.selectedMeta;
    const shopLink = document.getElementById('result-shop-link');
    if (shopLink && DRESS_URLS[state.selectedDress]) shopLink.href = DRESS_URLS[state.selectedDress];
  }

  document.querySelectorAll('.toggle-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.toggle-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const frame = document.getElementById('result-image-frame');
      if (btn.dataset.view === 'before') frame.classList.add('show-before');
      else frame.classList.remove('show-before');
    });
  });

  document.getElementById('try-another').addEventListener('click', () => { showStage('gallery'); });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); } });
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

})();
</script>

</body>
